# Environment Variables — CreatorBrainOG
# Copy this to .env.local and fill in your values

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── FastAPI Backend ───────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── AI (Google Gemini Flash) ──────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ── Scraping (Apify - Instagram Profile Scraper) ─────────────────────────────
APIFY_TOKEN=apify_api_your_token_here

# NOTE: The Gemini API key and Apify token are required for LIVE Instagram profile analysis.
# Apify is used for Instagram data extraction, and Gemini Flash is used for content DNA analysis.
